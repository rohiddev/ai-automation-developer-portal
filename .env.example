# GCP / Vertex AI
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=

# Models
ROUTER_MODEL=gemini-2.0-flash
IDP_ASSISTANT_MODEL=gemini-2.0-flash
WORKFLOW_MODEL=gemini-2.0-flash
PIPELINE_MODEL=gemini-2.0-flash
APPROVAL_MODEL=gemini-2.0-flash
AUDIT_MODEL=gemini-2.0-flash
EXECUTION_MODEL=gemini-2.0-flash

# Retrieval backend: vertex-ai-search | mock
RETRIEVAL_BACKEND=mock
VERTEX_AI_SEARCH_ENGINE=
VERTEX_AI_SEARCH_LOCATION=us-central1

# Pluggable adapters: memory | harness | vault | gsm | cloud_logging
ADAPTER_ORCHESTRATOR=memory
ADAPTER_SECRET_STORE=memory
ADAPTER_AUDIT_STORE=memory

# Harness IDP / Platform API (used when ADAPTER_ORCHESTRATOR=harness)
HARNESS_IDP_BASE_URL=https://app.harness.io/ng
HARNESS_ACCOUNT_IDENTIFIER=
HARNESS_ORG_IDENTIFIER=default
HARNESS_PROJECT_IDENTIFIER=
HARNESS_API_KEY_SECRET=projects/your-project/secrets/harness-api-key/versions/latest
HARNESS_DELEGATE_SELECTOR=act-delegate-k8s-ephub-p2r1

# Governance
PHI_REDACTION_ENABLED=true
AUDIT_LOGGING_ENABLED=true
SECRETS_VIA_VAULT=true
VAULT_ADDR=https://vault.yourcompany.com

# Observability
LOG_LEVEL=INFO
ENABLE_CLOUD_LOGGING=true
ENABLE_CLOUD_TRACE=true
